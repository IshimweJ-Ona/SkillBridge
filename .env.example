# Deploy-time overrides for docker-compose.yml (compose auto-loads a ".env"
# file sitting next to it - copy this to ".env" and fill in real values
# before deploying anywhere that isn't localhost). Everything here has a
# working localhost default baked into docker-compose.yml, so this file is
# only needed when the deployment target isn't your own machine.
#
# Per-service secrets (Resend, MTN MoMo, Cloudinary, Google OAuth, etc.)
# still live in backend/.env - see backend/.env.example. This file only
# covers values docker-compose.yml itself substitutes.

# --- Database ---------------------------------------------------------------
# Without this set, DATABASE_URL falls back to the bundled local `postgres`
# service (only started with `--profile local-db`) - fine for local dev, not
# for a real deployment. Set this to an external database instead, e.g. a
# Neon pooled connection string (Project -> Connect -> "Pooled connection" -
# important with 5 separate backend services each running their own Prisma
# pool) with sslmode=require:
#   DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/SB_DB?sslmode=require
# Both app servers behind your load balancer should point at this same
# value, so there is exactly one database, not one per server.
DATABASE_URL=

# --- Shared secret across all 5 backend services --------------------------
AUTH_TOKEN_SECRET=change-this-before-production

# --- Backend-facing URLs (read by the backend containers) -----------------
# The publicly reachable URL of the frontend deployment - used to build
# password-reset links and the Google OAuth redirect-back destination, and
# to populate the CORS allow-list.
APP_BASE_URL=https://your-frontend-domain.example
CORS_ORIGIN=https://your-frontend-domain.example
PASSWORD_RESET_URL=https://your-frontend-domain.example/en/reset-password
# learning-api's own publicly reachable URL - used to build the badge
# verifyUrl (GET /badges/verify/:uuid lives on learning-api specifically,
# not identity-api).
LEARNING_API_PUBLIC_URL=https://your-learning-api-domain.example/api/v1

# --- Browser-facing URLs (baked into the frontend's client JS bundle at ---
# --- `docker build` time - see frontend/Dockerfile) ------------------------
# Every SkillBridge API call happens client-side in the user's browser, so
# these must be URLs the browser can actually reach - not Docker-internal
# service names like "http://identity-api:3101". Set "false" once your
# backend is deployed and reachable at the URLs below.
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_IDENTITY_API_URL=https://your-identity-api-domain.example/api/v1
NEXT_PUBLIC_LEARNING_API_URL=https://your-learning-api-domain.example/api/v1
NEXT_PUBLIC_MATCHING_API_URL=https://your-matching-api-domain.example/api/v1
NEXT_PUBLIC_MARKETPLACE_API_URL=https://your-marketplace-api-domain.example/api/v1
NEXT_PUBLIC_ADMIN_API_URL=https://your-admin-api-domain.example/api/v1
NEXT_PUBLIC_WS_URL=https://your-matching-api-domain.example
