# SkillBridge backend environment (local development)
#
# Copy this file to `.env` in the same folder, then fill in the sections
# marked REQUIRED. Everything else has a working default for local dev and
# can stay as-is until you actually need that integration.
#
#   cp .env.example .env
#
# This one file is shared by all 5 backend service processes (identity,
# learning, matching, marketplace, admin) - each reads the same .env, only
# PORT/SKILLBRIDGE_SERVICE differ per process (set automatically by
# `ecosystem.config.js` / docker-compose.yml, not something you set here).

# --- Database (REQUIRED) -----------------------------------------------------
# Must point at a real Postgres 16 database named SB_DB - see the root
# README.md "Database" section for how to create it locally.
DATABASE_URL="postgresql://sb_user:sb_password@localhost:5432/SB_DB?schema=public"

# --- Service port (only PORT is actually read - set automatically per --------
# --- process by ecosystem.config.js / docker-compose.yml; change this one ---
# --- value only if running a single service natively and 3101 is taken) -----
PORT=3101

# --- Public URLs (REQUIRED to be correct, defaults work for local dev) ------
# Where the frontend is reachable - used to build password-reset links, the
# Google OAuth redirect-back destination, and the CORS allow-list.
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/en/reset-password
# learning-api's own publicly reachable URL - used only to build the badge
# verifyUrl (GET /badges/verify/:uuid lives on learning-api specifically,
# not identity-api - see src/challenges/challenges.service.ts).
LEARNING_API_PUBLIC_URL=http://localhost:3102/api/v1

# --- Auth (REQUIRED: change AUTH_TOKEN_SECRET before any shared/deployed use)
# Any long random string works for local dev; generate one with e.g.
# `openssl rand -hex 32`. Every service must use the same value.
AUTH_TOKEN_SECRET=change-this-before-production
AUTH_ACCESS_TOKEN_EXPIRES_IN_SECONDS=86400
AUTH_REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
JWT_AUDIENCE=skillbridge-api
# Auth cookies default to Secure whenever NODE_ENV=production, which is
# correct once you're behind real HTTPS termination. If you're running
# production-mode containers (e.g. docker-compose) without TLS in front yet,
# set this to false - otherwise the browser silently drops the cookie and
# login never persists, even though the API call itself succeeds.
COOKIE_SECURE=

# --- Email (Resend) - OPTIONAL for local dev --------------------------------
# Leave RESEND_API_KEY empty and the app still works: OTPs, password resets,
# and notifications are just skipped (logged, not sent) instead of erroring.
# Get a key at https://resend.com once you want real email delivery.
RESEND_API_KEY=
RESEND_FROM_EMAIL=authapp05@gmail.com
RESEND_FROM_NAME=SkillBridge
RESEND_FEEDBACK_TO_EMAIL=authapp05@gmail.com
RESEND_API_URL=https://api.resend.com/emails

# --- WhatsApp (phone-only youth signup delivery) - OPTIONAL for local dev ---
# Leave empty and phone-only accounts simply can't receive OTP/reset codes
# until this is configured; email-based accounts are unaffected.
WHATSAPP_SYSTEM_PHONE=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- File uploads: Cloudinary - OPTIONAL for local dev ----------------------
# Leave empty and the frontend's file upload fields fall back to manual URL
# entry instead of a real upload widget. Get credentials at
# https://cloudinary.com once you want real signed uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google OAuth 2.0 (FR 1.4) - OPTIONAL for local dev ---------------------
# Manual flow via GET /auth/google and GET /auth/google/callback (no
# @nestjs/passport dependency). Leaving these unset makes /auth/google
# redirect to the frontend with an error rather than crash - password-based
# signup/login is unaffected either way. GOOGLE_REDIRECT_URI must exactly
# match a redirect URI registered on the Google Cloud OAuth client, e.g.
# http://localhost:3101/api/v1/auth/google/callback in local development.
# Create credentials at https://console.cloud.google.com/apis/credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- Tuning (OPTIONAL - sensible defaults baked into the code, only set -----
# --- these if you actually need to change the default behavior) ------------
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX_REQUESTS=60
# REQUEST_BODY_LIMIT=1mb
# NODE_ENV and SKILLBRIDGE_SERVICE are set automatically per-process by
# ecosystem.config.js / docker-compose.yml - no need to set them here.
