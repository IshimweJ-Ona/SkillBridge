# SkillBridge backend environment — DEPLOYMENT (server) version
#
# This is the deploy counterpart to `.env.example` (which is written for
# local dev). On the server:
#
#   cp .env.deploy.example .env
#
# then fill in every  CHANGE ON DEPLOY line below. `docker-compose.yml`
# loads this file into all 5 backend containers via `env_file`.
#
# IMPORTANT — two different files control backend config when deploying with
# Docker, and they are NOT interchangeable:
#   1. THIS file (backend/.env) - secrets and integration credentials only.
#   2. The root .env (next to docker-compose.yml, copy it from the root
#      .env.example) - DATABASE_URL, AUTH_TOKEN_SECRET, domains/CORS, and the
#      frontend's NEXT_PUBLIC_* build args.
# Reason: docker-compose.yml's `environment:` block deliberately overrides
# DATABASE_URL, AUTH_TOKEN_SECRET, APP_BASE_URL, CORS_ORIGIN,
# PASSWORD_RESET_URL, LEARNING_API_PUBLIC_URL, and every service's PORT for
# all 5 containers — so editing those values in THIS file has **no effect**
# when running via `docker compose up`. Each var below is marked with which
# file actually controls it under Docker so you don't spend time editing the
# wrong one.

# --- Database —  CONTROLLED BY THE ROOT .env, NOT THIS FILE --------------
# DATABASE_URL here is only read if you ever run a backend service natively
# (no Docker) on the server. For the normal Docker deployment path, set
# DATABASE_URL in the root .env instead (e.g. your Neon pooled connection
# string with ?sslmode=require).
DATABASE_URL="postgresql://sb_user:sb_password@localhost:5432/SB_DB?schema=public"

# --- Service ports —  CONTROLLED BY docker-compose.yml, NOT THIS FILE ----
# Each container's actual PORT is fixed in docker-compose.yml (3101-3105).
# These are only read if running natively without Docker. Leave as-is.
PORT=3101
IDENTITY_API_PORT=3101
LEARNING_API_PORT=3102
MATCHING_API_PORT=3103
MARKETPLACE_API_PORT=3104
ADMIN_API_PORT=3105

# --- Public URLs —  CONTROLLED BY THE ROOT .env, NOT THIS FILE -----------
# Set the real values (APP_BASE_URL, CORS_ORIGIN, PASSWORD_RESET_URL,
# LEARNING_API_PUBLIC_URL) in the root .env instead. Leave these as local
# defaults here - they're only read if running natively without Docker.
APP_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PASSWORD_RESET_URL=http://localhost:3000/en/reset-password
LEARNING_API_PUBLIC_URL=http://localhost:3102/api/v1

# --- Auth —  AUTH_TOKEN_SECRET IS CONTROLLED BY THE ROOT .env ------------
# Set the real secret in the root .env (`openssl rand -hex 32`). The two
# expiry values and JWT_AUDIENCE below ARE read from this file under Docker -
# fine to leave as the local defaults unless you want to change token
# lifetimes.
AUTH_TOKEN_SECRET=change-this-before-production
AUTH_ACCESS_TOKEN_EXPIRES_IN_SECONDS=86400
AUTH_REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
JWT_AUDIENCE=skillbridge-api

# --- Email (Resend) —  read from THIS file —  CHANGE ON DEPLOY ---------
# Works with RESEND_API_KEY empty (emails just get skipped), but for a real
# deployment you almost certainly want this configured so OTPs/password
# resets/notifications actually send. Get a key at https://resend.com.
RESEND_API_KEY=
RESEND_FROM_EMAIL=authapp05@gmail.com
RESEND_FROM_NAME=SkillBridge
RESEND_FEEDBACK_TO_EMAIL=authapp05@gmail.com
RESEND_API_URL=https://api.resend.com/emails

# --- WhatsApp (phone-only youth signup delivery) —  read from THIS file —
# ---  CHANGE ON DEPLOY if phone-only signup needs to actually work -------
WHATSAPP_SYSTEM_PHONE=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# --- Payments: MTN Mobile Money —  read from THIS file —  CHANGE ON ----
# --- DEPLOY if you want real payment flows to work -------------------------
# MOMO_CALLBACK_HOST in particular MUST become a real public HTTPS URL your
# server owns once deployed - MTN's API calls back to it. The sandbox
# placeholder below (webhook.site) is a local-testing-only value and will
# not work as a real callback destination.
PAYMENT_PROVIDER=mtn-momo-sandbox
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENV=sandbox
MOMO_CALLBACK_HOST=https://your-real-server-domain.example/api/v1/payments/momo/callback
MOMO_COLLECTION_SUBSCRIPTION_KEY=
MOMO_COLLECTION_API_USER=
MOMO_COLLECTION_API_KEY=
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=
MOMO_DISBURSEMENT_API_USER=
MOMO_DISBURSEMENT_API_KEY=

# --- File uploads: Cloudinary —  read from THIS file —  CHANGE ON ------
# --- DEPLOY if you want real signed uploads instead of the manual-URL ------
# --- fallback -----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google OAuth 2.0 —  read from THIS file —  CHANGE ON DEPLOY -------
# GOOGLE_REDIRECT_URI MUST use your real public identity-api domain, and
# that exact URL must also be registered on the Google Cloud OAuth client -
# https://console.cloud.google.com/apis/credentials. It cannot be
# localhost once deployed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-real-identity-api-domain.example/api/v1/auth/google/callback

# --- Tuning —  read from THIS file — OPTIONAL, sensible defaults ---------
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX_REQUESTS=60
# REQUEST_BODY_LIMIT=1mb
